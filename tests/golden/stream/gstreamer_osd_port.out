== shim calls (sorted: background jobs make the order non-deterministic)
fbi -d /dev/fb0 -a -fitwidth -T 1 --noverbose <ROOT>/gs/wallpaper.png
gpiofind PIN_22
gst-launch-1.0 -e udpsrc port=5600 caps=application/x-rtp, media=(string)video, clock-rate=(int)90000, encoding-name=(string)H265 ! rtph265depay ! h265parse ! mppvideodec ! kmssink
jq .widgets += (input.widgets) <ROOT>/etc/pixelpilot/pixelpilot_osd_simple.json <ROOT>/etc/pixelpilot/pixelpilot_osd_osmon.json
wfb-ng-osd -p 14560
