start configure radxa0 usb gadget network
== shim calls
setfont /usr/share/consolefonts/CyrAsia-TerminusBold32x16.psf.gz
blkid 
sgdisk -ge /dev/mmcblk0
parted -m /dev/mmcblk0 unit MiB print
parted ---pretend-input-tty /dev/mmcblk0
parted-stdin: resizepart 4 2900MiB
parted-stdin: yes
resize2fs /dev/mmcblk0p4
parted -m /dev/mmcblk0 unit MiB print
parted -s /dev/mmcblk0 mkpart videos fat32 1400MiB 100%
mkfs.exfat -L videos /dev/mmcblk0p5
mount -o remount,rw <ROOT>/media/root-ro
dtc -I dts -O dtb -o <ROOT>/media/root-ro/boot/dtbo/rk3566-hdmi-max-resolution-4k.dtbo.disabled <ROOT>/gs/rk3566-hdmi-max-resolution-4k.dts
dtc -I dts -O dtb -o <ROOT>/media/root-ro/boot/dtbo/rk3566-dwc3-otg-role-switch.dtbo <ROOT>/gs/rk3566-dwc3-otg-role-switch.dts
dtc -I dts -O dtb -o <ROOT>/media/root-ro/boot/dtbo/rk3566-ina226-overlay.dtbo.disabled <ROOT>/gs/rk3566-ina226-overlay.dts
systemctl disable gs-init.service
stub gs-applyconf.sh 
== gs.conf changes
== file /etc/wifibroadcast.cfg
[common]
wifi_channel = '161'
wifi_region = '00'

[gs_mavlink]
peer = 'connect://224.0.0.1:14550'

[gs_video]
peer = 'connect://224.0.0.1:5600'

[cluster]

nodes = {
          '127.0.0.1': { 'wlans': ['wlan'], 'wifi_txpower': None, 'server_address': '127.0.0.1' },
          # Remote cards:
          #'192.168.1.123' : { 'wlans': ['wlan0', 'wlan1'], 'wifi_txpower': 'off'},    # rx-only node
          #'192.168.1.155' : { 'wlans': ['wlan0', 'wlan1']},     # rx/tx node
        }

server_address = '192.168.1.20'

== file /etc/default/gpsd
stty -F /dev/ttyS3 38400
START_DAEMON="true"
DEVICES="/dev/ttyS3"
GPSD_OPTIONS="-n -b -G -r"
USBAUTO="true"
== file /etc/samba/smb.conf
[global]
[Videos]
   path = /Videos
   writable = yes
   browseable = yes
   create mode = 0777
   directory mode = 0777
   guest ok = yes
   force user = root

[config]
   path = /config
   writable = yes
   browseable = yes
   create mode = 0777
   directory mode = 0777
   guest ok = yes
   force user = root
== file /media/root-ro/etc/fstab
/dev/mmcblk0p5 <ROOT>/Videos exfat defaults,nofail 0 0
== file /etc/network/interfaces.d/radxa0
auto radxa0
allow-hotplug radxa0
iface radxa0 inet static
        address 192.168.2.20/24
        # post-up mount -o remount,ro /Videos && link mass
        # post-down remove mass && mount -o remount,rw /Videos
        up /usr/sbin/dnsmasq --conf-file=/dev/null --no-hosts --bind-interfaces --except-interface=lo --clear-on-reload --strict-order --listen-address=192.168.2.20 --dhcp-range=192.168.2.21,192.168.2.199,12h --dhcp-lease-max=5 --pid-file=<ROOT>/run/dnsmasq-radxa0.pid --dhcp-option=3 --dhcp-option=6
== file /dev/ttyFIQ0

