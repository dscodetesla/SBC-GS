norm ['quoted pass'] -> rc=0 out=['quoted pass']
norm ["dq"] -> rc=0 out=[dq]
norm [] -> rc=0 out=[]
norm [x;y] -> rc=0 out=['x;y']
norm [it's] -> rc=1 out=[]
norm [a b~] -> rc=0 out=['a b']
norm [$(x)] -> rc=0 out=['$(x)']
