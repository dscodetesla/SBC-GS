# Copy to ./env and edit. Sourced by every bench script.

# --- Radio (REQUIRED: choose the region you are legally allowed to use) ---
WFB_REGION=""            # e.g. your country code; no default on purpose
WFB_CHANNEL="165"        # 165 = 5825 MHz (see wfb-ng installer comment)
WFB_NICS=""              # empty = wfb-ng autodetects rtl88xxau_wfb / rtl88x2eu adapters
TX_PWR_IDX="1"           # 8812au: rtw_tx_pwr_idx_override; keep minimal on the bench
RTL8812AU_REF="6e75916416de1dce5ecd37f824896bebf96aaf8f"  # svpcom/rtl8812au commit "Fix build on Raspberry Pi with kernel 6.18 headers"
DRIVER="8812au"          # 8812au | 8812eu | 8814au (in-kernel, >=6.15) | 8814au-morrownr (needs ALLOW_UNPINNED=1); wfb-ng does NOT support 8814au

# --- Video emulation (air node) ---
VIDEO_CODEC="h264"       # h264 | h265  (x265 is heavy for a Pi 4 CPU)
VIDEO_W="1280"
VIDEO_H="720"
VIDEO_FPS="30"
VIDEO_BITRATE_KBPS="4000"
VIDEO_PATTERN="ball"     # videotestsrc pattern

# --- Ports (match wfb-ng defaults used in this repo) ---
AIR_VIDEO_PORT="5602"    # drone_video listen port (SRC: wfb-ng Setup-HOWTO)
GS_VIDEO_PORT="5600"     # gs_video connect port
MAV_PORT="14550"         # mavlink on both sides

# --- MAVLink emulation ---
FC_SYSID="1"             # do not use 3 (wfb-ng injects sysid 3 messages)

# --- GS video output ---
DECODER=""               # empty = auto (v4l2 if present, else libav); e.g. avdec_h264
SINK=""                  # empty = kmssink on console, autovideosink under X/Wayland

VENV="/opt/gs-bench/venv"

# --- Real-hardware variants ---
SOURCE="test"            # air video: test (videotestsrc) | webcam (UVC via v4l2src)
WEBCAM_DEV="/dev/video0"
WEBCAM_FORMAT="jpeg"     # jpeg (MJPEG, common on UVC) | raw
ENCODER="x264"           # x264 | v4l2h264enc (EXPERIMENTAL, Pi 4 hardware encoder, untested)
FC_SERIAL=""             # air: real FC on USB, e.g. ttyACM0; empty = use fake_fc.py
FC_BAUD="115200"         # only meaningful for UART FCs; ArduPilot USB (SERIAL0) ignores it
GS_FORWARD_IP=""         # gs: IP of the host to forward video+MAVLink to over LAN; empty = local
