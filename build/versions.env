OVERLAYROOT_URL=http://ftp.cn.debian.org/debian/pool/main/c/cloud-initramfs-tools/overlayroot_0.18.debian13+deb12u1_all.deb  # :378 (plain http)
OVERLAYROOT_CUR="fixed file name, no checksum, http"; OVERLAYROOT_PIN=

# --- python packages (pip) ---
