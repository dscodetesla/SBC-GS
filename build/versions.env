MSPOSD_CUR="release tag 'latest' (moving)"; MSPOSD_PIN=
MSPOSD_FONTS_URL=https://raw.githubusercontent.com/OpenIPC/msposd/main/fonts/             # :186-191, 6 png files
MSPOSD_FONTS_CUR="branch main (moving)"; MSPOSD_FONTS_PIN=
ALINK_URL="https://github.com/OpenIPC/adaptive-link/releases/download/<tag>/alink_gs"       # :218-219
ALINK_CUR="first tag from api.github.com/repos/OpenIPC/adaptive-link/tags (moving)"; ALINK_PIN=
