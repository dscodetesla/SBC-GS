# Manifest of upstream components fetched by build/build.sh (docs/REPRODUCIBLE-BUILD.md).
# Shell-sourceable; NOTHING sources it yet (build.sh is unchanged in M5a).
# Per component NAME: NAME_REPO (URL), NAME_CUR (what build.sh fetches today),
# NAME_PIN (verified immutable ref: 40-hex commit SHA for git, sha256 for files; empty = UNVERIFIED).
# Pins stay empty until verified from the network (api/raw.githubusercontent.com via the proxy).
# Status 2026-10-02: GitHub API/raw for these repos was refused by the session proxy
# ("GitHub access to this repository is not enabled for this session"), so every PIN is UNVERIFIED.

# --- git clones (build.sh line in comment) ---
RTL8812AU_REPO=https://github.com/svpcom/rtl8812au.git        # :48
RTL8812AU_CUR="tag v5.2.20"; RTL8812AU_PIN=                   # tag is mutable; SHA UNVERIFIED
RTL88X2BU_REPO=https://github.com/OpenHD/rtl88x2bu.git        # :58
RTL88X2BU_CUR="HEAD of default branch"; RTL88X2BU_PIN=
RTL88X2CU_REPO=https://github.com/libc0607/rtl88x2cu-20230728.git  # :66
RTL88X2CU_CUR="HEAD of default branch"; RTL88X2CU_PIN=
