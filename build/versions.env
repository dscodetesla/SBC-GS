RTL88X2EU_CUR="HEAD of default branch"; RTL88X2EU_PIN=
RTL8733BU_REPO=https://github.com/libc0607/rtl8733bu-20230626.git  # :89
RTL8733BU_CUR="HEAD of default branch"; RTL8733BU_PIN=
RTW88_REPO=https://github.com/lwfinger/rtw88.git              # :99
RTW88_CUR="HEAD of default branch"; RTW88_PIN=
RADXA_KERNEL_REPO=https://github.com/radxa/kernel             # :113
RADXA_KERNEL_CUR="branch linux-5.10-gen-rkr4.1"; RADXA_KERNEL_PIN=
WFB_NG_REPO=https://github.com/svpcom/wfb-ng.git              # :153
WFB_NG_CUR="branch master"; WFB_NG_PIN=
PIXELPILOT_REPO=https://github.com/OpenIPC/PixelPilot_rk.git  # :165 (+ submodules, :172)
PIXELPILOT_CUR="HEAD of default branch"; PIXELPILOT_PIN=
WFB_NG_OSD_REPO=https://github.com/svpcom/wfb-ng-osd.git      # :194 (--recursive)
WFB_NG_OSD_CUR="HEAD of default branch"; WFB_NG_OSD_PIN=
RUBYFPV_REPO=https://github.com/RubyFPV/RubyFPV.git           # :203
RUBYFPV_CUR="tag 11.1"; RUBYFPV_PIN=                          # tag is mutable; SHA UNVERIFIED
YAML_CLI_REPO=https://github.com/OpenIPC/yaml-cli.git         # :260
YAML_CLI_CUR="HEAD of default branch"; YAML_CLI_PIN=

# --- binary/file downloads (PIN = sha256) ---
