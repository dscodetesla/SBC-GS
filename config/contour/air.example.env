# config/contour/air.example.env
# Контур AIR: WiFiLink2 (OpenIPC) + ArduPilot Copter 4.7.0 (Matek H743) + ELRS RX FT SE4 Xross Gemini (docs/DECISIONS.md R2, R5: 12S, R6).
# УСІ значення нижче: "стартова точка, перевірити на стенді" (docs/CONTOUR-AIR.md, розділ 6 і 9).
# Це НЕ параметри, перевірені на залізі. Позначки: SRC / REPO / SNIP / INF / HW / UNVERIFIED.
# Файл придатний для `. config/contour/air.example.env` (лише KEY=value). Нічого тут не застосовується автоматично.
# Префікс AIR_ навмисно відрізняється від bench/env.example (щоб не змішувати зі стендом на Pi).
# Порожнє значення = користувач має вирішити сам (регіон, канал).

### --- Відео (majestic, OpenIPC) ---
# Роздільність 720p. IMX415 заявлено 1080p60/720p120 (SRC: docs.openipc.org runcam-wifilink-v2). Ключ cli: .video0.size
AIR_VIDEO_SIZE="1280x720"
# 60 = типове для FPV-прошивки (SRC: OpenIPC/firmware wifibroadcast: cli -s .video0.fps 60); 30 якщо канал/декодер GS не тягне. Ризик: на 60 к/с пік IDR більший.
AIR_VIDEO_FPS="60"
# h265: типове у прошивці (SRC wifibroadcast: .video0.codec h265) і єдиний апаратний декодер на Pi 5 (SNIP docs/PI-PORT.md:99). h264 на Pi 5 = програмний декодер (CPU не виміряно).
AIR_VIDEO_CODEC="h265"
# cbr = типове у прошивці (SRC wifibroadcast: .video0.rcMode cbr)
AIR_VIDEO_RCMODE="cbr"
# Стартовий бітрейт 720p. alink-профілі: MCS1 -> 4000, MCS2 -> 8000 кбіт/с (SRC adaptive-link README). Прошивка за замовч. 8000 для 1080p60 (SRC). Підбирається за вимірюванням (розділ 9, M2).
AIR_VIDEO_BITRATE_KBPS="4000"
# gopSize: приклад "1.0" з OpenIPC/sandbox-fpv gkrcparams.md (SRC, для mcs1/1080p); одиниця виміру в alink-прикладах неузгоджена (UNVERIFIED), alink шле "%.1f". Ризик: довший GOP = довше відновлення після втрати.
AIR_VIDEO_GOP="1.0"
# Експозиція: прошивка ставить .isp.exposure 16 (SRC wifibroadcast). Одиниця (мс?) UNVERIFIED; 16 мс ~ 1/60 с (INF).
AIR_ISP_EXPOSURE="16"
# 3DNR вимкнено заради затримки (SRC: коментар у wifibroadcast, .video0.noiseLevel 0)
AIR_VIDEO_NOISELEVEL="0"
# qpDelta: -12 у всіх прикладних профілях alink (SRC adaptive-link README)
AIR_VIDEO_QPDELTA="-12"

### --- Радіо wfb-ng (AIR TX = RunCam custom RTL8812EU, GS = RTL8812AU/EU) ---
# РЕГІОН І КАНАЛ ОБИРАЄ КОРИСТУВАЧ. Підказки з джерел: 161 (RunCam docs, SRC), 165 (wfb-ng master.cfg, SRC). Не підставляти, доки не відомий дозволений канал.
AIR_WFB_REGION=""
AIR_WFB_CHANNEL=""
# 20 МГц: RTL8812EU передає лише 5/10/20 МГц, 40 МГц лише прийом (SRC docs.openipc.org rtl8812eu)
AIR_WFB_WIDTH="20"
# MCS1 = типове за README alink; пакет прошивки wfb.yaml містить mcs_index 2 (SRC, розбіжність між джерелами)
AIR_WFB_MCS="1"
AIR_WFB_GI="long"
# STBC/LDPC = 1: прошивка ставить для 8812au/8812eu (SRC wifibroadcast); wfb-ng: LDPC потрібен на обох кінцях (SRC master.cfg)
AIR_WFB_STBC="1"
AIR_WFB_LDPC="1"
# FEC 8/12 = типове (SRC wfb-ng master.cfg [video], OpenIPC wfb.yaml)
AIR_WFB_FEC_K="8"
AIR_WFB_FEC_N="12"
# Потужність: на стенді мінімум. alink power_level_0_to_4 (0 = pit, SRC alink.conf). Абсолютні дБм UNKNOWN (розділ 9).
AIR_WFB_POWER_LEVEL="0"
# Максимум за специфікацією RunCam: 28 дБм FCC / 20 дБм CE (SRC docs.openipc.org). Дозволене вам значення визначає регіон.
AIR_WFB_REGION_MAX_DBM=""

### --- Adaptive Link (alink_drone на камері, alink_gs на GS) ---
# Перший прогін без alink (фіксований профіль), потім вмикати. У заводській прошивці alink може бути не встановлений (SRC docs.openipc.org installing-alink-runcam, станом на 2025-04).
AIR_ALINK_ENABLE="0"
# Типові значення alink.conf у main (SRC OpenIPC/adaptive-link alink.conf)
AIR_ALINK_FALLBACK_MS="1000"
AIR_ALINK_HOLD_FALLBACK_S="1"
AIR_ALINK_MIN_BETWEEN_CHANGES_MS="200"
AIR_ALINK_HOLD_MODES_DOWN_S="3"
AIR_ALINK_HYSTERESIS_PCT="5"
AIR_ALINK_ALLOW_REQUEST_KEYFRAME="1"
# Пороги alink_gs з прикладу документації (SRC); під ваш RTL8812 ПЕРЕМІРЯТИ
AIR_ALINK_RSSI_MIN="-80"
AIR_ALINK_RSSI_MAX="-40"
AIR_ALINK_SNR_MIN="12"
AIR_ALINK_SNR_MAX="36"
# wfb-ng log_interval на GS для alink: 200 мс (SRC adaptive-link README; типово 1000)
AIR_ALINK_GS_LOG_INTERVAL_MS="200"

### --- Телеметрія камера <-> FC (одна UART WiFiLink2, SRC docs.openipc.org) ---
# mavfwd (MAVLink) АБО msposd (MSP OSD): одночасно на одній UART не можна (SRC OpenIPC/msposd README). Для телеметрії ArduPilot -> mavfwd.
AIR_TELEMETRY_ROUTER="mavfwd"
# 115200: так у скрипті прошивки (SRC wifibroadcast: mavfwd -b 115200)
AIR_UART_BAUD="115200"
# Пристрій у камері: ttyS2 у прикладі wfb.yaml (SRC OpenIPC/firmware wfb.yaml); для WiFiLink2 UNVERIFIED
AIR_CAM_SERIAL="ttyS2"

### --- ArduPilot (Matek H743): стартові параметри; імена перевірити за версією прошивки ---
# SERIAL1 = UART7 (Telem1, RTS/CTS), SERIAL2 = USART1 (Telem2): SRC ardupilot.org common-matekh743-wing + hwdef.dat. Який UART виведено на вашій платі v3: UNVERIFIED.
AP_TELEM_SERIAL_N="1"
AP_SERIALN_PROTOCOL="2"
# 115 = 115200 (SRC ardupilot.org parameters, SERIAL1_BAUD)
AP_SERIALN_BAUD="115"
# RC: CRSF/ELRS потребує справжнього UART з RX+TX (SRC ardupilot.org common-rc-systems). SERIAL7 (USART6) лише з BRD_ALT_CONFIG=1 на не-bdshot прошивці, або вільний UART (SERIAL5 UART8/SERIAL6 UART4).
AP_RC_SERIAL_N="7"
AP_RC_SERIALN_PROTOCOL="23"
AP_BRD_ALT_CONFIG="1"
AP_SERIALN_OPTIONS_CRSF="0"
# Лише CRSF; ELRS-CRSF 420 кбод не вмикати без потреби (RC_OPTIONS біт 13, SRC parameters)
AP_RC_PROTOCOLS="512"
# RSSI_TYPE=3 (ReceiverProtocol): SRC ardupilot.org common-rc-systems (приклад Ghost); для ELRS-CRSF UNVERIFIED
AP_RSSI_TYPE="3"
# Біт 11 (2048): LQ як RSSI для CRSF (SRC parameters RC_OPTIONS). Для польоту розгляньте додати біт 1 (+2 = 2050) "Ignore MAVLink Overrides" (INF), але тоді bench/tx12_bridge.py і gs_mav.py --rc не діятимуть.
AP_RC_OPTIONS="2048"
# Потоки MAVLink на порту камери (в нових доках MAVn_*, у старіших SRn_*): INF, перевірити скриптом/ніком GCS
AP_MAV_EXT_STAT_HZ="2"
AP_MAV_POSITION_HZ="3"
AP_MAV_EXTRA1_HZ="10"
AP_MAV_EXTRA2_HZ="2"
AP_MAV_EXTRA3_HZ="1"
AP_MAV_RC_CHAN_HZ="2"
AP_MAV_RAW_SENS_HZ="0"
AP_MAV_PARAMS_HZ="0"
# GCS: типово 255 (SRC docs/MAVLINK-ROUTER.md); sysid FC НЕ 3 (wfb-ng ін'єктує sysid 3)
AP_MAV_GCS_SYSID="255"
AP_MAV_SYSID="1"
# GCS failsafe: 0 до перевірки на стенді; перед польотом свідомо вибрати (Copter: 1 = RTL). Тип апарата невідомий (Plane має інші імена).
AP_FS_GCS_ENABLE="0"
AP_FS_GCS_TIMEOUT="5"
# RC failsafe: Copter FS_THR_ENABLE 0..7, 1 = RTL; ELRS CRSF під час втрати зв'язку припиняє кадри (INF), тож тригер -- RC_FS_TIMEOUT
AP_FS_THR_ENABLE="1"
AP_RC_FS_TIMEOUT="1"
AP_RC_OVERRIDE_TIME="3"

### --- ELRS (приймач FT SE4 Dual Band Xross Gemini, LR1121, ESP32-C3, 4 антени; docs/DECISIONS.md R2 перегляд) ---
# Користувач: приймач на 900 МГц; TX12 MKII: внутрішній Multi (CC2500, 2.4 ГГц) + зовнішній JR-модуль. Зовнішній модуль мусить бути ELRS 900 МГц
# (клас ES900TX), та сама bind-фраза/регіон/мажорна версія ELRS; внутрішній Multi у моделі польоту OFF. Альтернатива V-X (Xrossband, два LR1121 у TX): лише
# якщо наклейка/Lua приймача так каже; тоді ELRS_TX_MODE="Xrossband", рейти X150Hz/X100Hz Full (SRC expresslrs.org lua-howto).
ELRS_TX_MODE="900MHz-single-band"
# Рейти 900 МГц: 25/50/100/200 Hz, 100 Full, D50 (SRC lua-howto). Стартовий 100 Hz (SYNTH); чутливість кожного рейту читати в Lua.
ELRS_PACKET_RATE="100"
# Std = автоматичне співвідношення (SRC lua-howto); Dynamic Power потребує телеметрії (SRC)
ELRS_TLM_RATIO="Std"
ELRS_DYNAMIC_POWER="Dyn"
# Лише CRSF; нативний MAVLink ELRS вимкнено (дубль телеметрії, див. docs/BENCH-HARDWARE.md розділ 5)
ELRS_LINK_MODE="Normal"
ELRS_RX_PROTOCOL="CRSF"
# Однакова мажорна версія на TX і RX; 3.5.0 потрібна для XR4/Xrossband (SRC ExpressLRS/targets targets.json), для 900 МГц-приймача UNVERIFIED
ELRS_MIN_VERSION="3.5.0"
