# config/contour/gs.example.env
# Контур GS: Raspberry Pi 5 (4 ГБ) + RTL8812AU + TX12 MKII + хост Ubuntu 26.04+ (docs/CONTOUR-GS.md).
# УСІ значення: «стартова точка, перевірити на стенді». Жодне не виміряне на залізі.
# Ключі лише з config/registry.tsv (loader відхиляє невідомі). Файл придатний і для `. gs.example.env`
# (лише KEY=value), і для `config/sbc-gs-config check config/contour/gs.example.env`.
# Позначки: SRC / REPO / SNIP / INF / HW / UNVERIFIED / UNMEASURED. Порожнє значення = вирішує користувач.
# Значення AIR-сторони синхронізувати з config/contour/air.example.env.

### --- Радіо (RTL8812AU на GS; AIR = RTL8812EU WiFiLink2) ---
# Регіон: НЕ задаємо (правила країни користувача). У gs/gs.conf:98 стоїть '00'; у bench порожньо навмисно.
WFB_REGION=''
# Канал має збігатися з AIR. 165 = 5825 МГц (REPO bench/env.example:5, wfb-ng master.cfg); gs/gs.conf:97 має 161: КОНФЛІКТ, вирішує AIR.
WFB_CHANNEL=165
# Порожньо = автовизначення rtl88xxau_wfb (REPO bench/README). Одна карта, diversity не потрібне (SRC wfb-ng Setup-HOWTO п. 11).
WFB_NICS=''
# 8812au rtw_tx_pwr_idx_override; на GS TX лише MAVLink-аплінк; мінімум на столі (REPO bench/env.example:6). Реальна потужність UNMEASURED.
TX_PWR_IDX=1
# svpcom/rtl8812au «Fix build on Raspberry Pi with kernel 6.18 headers» (REPO bench/env.example:8). 16K/6.12: HW, див. docs/SIM-DKMS.md коли з'явиться.
RTL8812AU_REF=6e75916416de1dce5ecd37f824896bebf96aaf8f
# Донгл GS = 8812AU (за користувачем), svpcom-драйвер (SRC wfb-ng wiki WiFi-hardware: офіційно лише 8812au/8812eu).
DRIVER=8812au

### --- Відео (на GS/хості) ---
# h265 = типове в прошивці OpenIPC (SRC air.example.env) і єдиний апаратний кодек Pi 5 (SRC bcm2712_defconfig:1034). Хост x86 декодує обидва. H.264 на Pi 5 лише ПЗ (SNIP).
VIDEO_CODEC=h265
# 720p за користувачем (MEMORY.md §2).
VIDEO_W=1280
VIDEO_H=720
# 60 як у air.example.env (FPV-типове, SRC OpenIPC); 30 якщо декод/канал не тягне. Затримка UNMEASURED.
VIDEO_FPS=60
# Стартовий бітрейт для MCS1/20 МГц (SRC docs/BENCH-HARDWARE.md §7: alink 4 Мбіт/с). Підбирати за втратами FEC: HW.
VIDEO_BITRATE_KBPS=4000
# wfb-ng gs_video connect-порт (SRC master.cfg:314, Setup-HOWTO).
GS_VIDEO_PORT=5600
# wfb-ng gs_mavlink connect-порт (SRC master.cfg:319).
MAV_PORT=14550
# Куди форвардити відео+MAVLink з Pi 5 (IP хоста Ubuntu). Порожньо = локально. ВКАЗАТИ ПІД ВАШУ МЕРЕЖУ.
GS_FORWARD_IP=''
# Порожньо = авто (v4l2 якщо є, інакше libav; REPO bench/video-rx.sh:21). Базово декодує хост: avdec_h265/avdec_h264 або VA-API (gstreamer1.0-plugins-bad, SRC archive.ubuntu.com). На Pi 5 v4l2slh265dec потребує формату COL128: UNVERIFIED на GStreamer 1.22 (Bookworm).
DECODER=''
# Порожньо = kmssink з консолі, autovideosink під Wayland (REPO bench/video-rx.sh:26-28). На хості Ubuntu 26.04 сеанс лише Wayland (INF).
SINK=''
# FC sysid за замовчуванням ArduPilot 1; не 3 (wfb-ng ін'єктує sysid 3, REPO registry FC_SYSID).
FC_SYSID=1

### --- RC-міст TX12 -> MAVLink (ТІЛЬКИ резерв/стенд, без гвинтів; основний RC = ELRS, docs/CONTOUR-GS.md §3.6) ---
# Куди шле міст: порт клієнтів gs-mavlink 14560 (REPO gs/mavlink/gs-mavlink.conf.example GCS_UDP_PORTS), а не upstream 14550 wfb-ng.
TX12_CONN=udpout:127.0.0.1:14560
# Має дорівнювати MAV_GCS_SYSID на FC (REPO config/registry.tsv:7, docs/MAVLINK-ROUTER.md §6). 255 = типово.
TX12_SYSID=255
# Dead-man 300 мс (REPO registry TX12_DEADMAN_MS; SAFETY-ключ). Реальний інтервал HID-звітів TX12: HW (залежить від періоду RF-модуля, docs/CONTOUR-GS.md §3.5).
TX12_DEADMAN_MS=300
# Захід: 20 Гц (REPO registry), максимум 50 Гц.
TX12_RATE_HZ=20.0
# Мапа осей. Файл-приклад має плейсхолдери -1024..1024; EdgeTX Classic дає 0..2047, центр 1024 (SRC usb_joystick.cpp:114-117,617): скопіювати й виправити під реальний evtest.
TX12_MAP=''
