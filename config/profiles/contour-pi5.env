# Profile contour-pi5 (SBC_GS_PROFILE=contour-pi5): bench/GS starting values for the contour
# AIR = OpenIPC WiFiLink2 (RTL8812EU) 720p, GS = Pi 5 + RTL8812AU, ELRS 900 MHz RX, FC Matek H743 SLIM,
# MAVLink on the WiFiLink2 UART (reaches the GS through wfb-ng). ALL values are starting points, UNVERIFIED on hardware
# (docs/CONTOUR-AIR.md). Radio region and channel are deliberately NOT set: choose what you may legally use.
DRIVER=8812au
VIDEO_CODEC=h265          # the only hardware decoder on the Pi 5 (docs/PI-PORT.md)
VIDEO_W=1280
VIDEO_H=720
VIDEO_FPS=30              # the air side may run 60; lower here until the decoder load is measured
VIDEO_BITRATE_KBPS=4000
FC_SYSID=1                # ArduPilot default SYSID_THISMAV; never 3 (wfb-ng injects sysid 3)
FC_SERIAL=''              # MAVLink comes through wfb-ng from the WiFiLink2 UART, not from a local serial port
