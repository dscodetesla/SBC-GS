# Profile gs-hardened (SBC_GS_PROFILE=gs-hardened): GCS/TCP and upstream endpoints of gs-mavlink listen on loopback only.
# Audit S1/S2 recommendation (docs/CONFIG.md): the legacy default 0.0.0.0 exposes an unauthenticated MAVLink endpoint
# on every interface (hotspot included). Use ONLY when QGC/MAVProxy run on the GS itself or are reached through a tunnel.
LISTEN_ADDR='127.0.0.1'
UPSTREAM_BIND='127.0.0.1'
